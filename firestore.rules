rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles and roles are read through the revocation-aware backend.
    match /users/{userId} {
      allow read, write: if false;
    }
    // This contains only a change signal, never profile data or permissions.
    // Receiving a signal makes Flutter refetch the account through the API.
    match /account_access/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    match /audit_logs/{auditId} {
      allow read, write: if false;
    }
    match /client_profiles/{clientId} {
      allow read, write: if false;
    }
    match /conversations/{id} {
      allow read, write: if false;
    }
    // Package selection and verified activation use the revocation-aware API.
    match /package_catalog/{id} {
      allow read, write: if false;
    }
    match /package_memberships/{id} {
      allow read, write: if false;
    }
    match /package_membership_guards/{id} {
      allow read, write: if false;
    }
    // Notification data is accessed only through authenticated Cloud Functions.
    // The Admin SDK bypasses these rules after the HTTPS layer verifies identity.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Workflow records are backend-owned. Mobile clients use the application
    // APIs rather than writing workflow events directly.
    match /diet_plans/{document=**} {
      allow read, write: if false;
    }
    match /messages/{document=**} {
      allow read, write: if false;
    }
    match /tasks/{document=**} {
      allow read, write: if false;
    }
    match /payments/{document=**} {
      allow read, write: if false;
    }

    // Fitness packages are accessed through the authenticated API. The API
    // enforces admin-only creation and validates the persisted schema.
    match /packages/{packageId} {
      allow read, write: if false;
    }

    // Package change history is written atomically by the authenticated API.
    // Mobile clients cannot forge actors, timestamps, or before/after values.
    match /package_change_history/{historyId} {
      allow read, write: if false;
    }

    // Purchases contain immutable customer contract snapshots and are only
    // accessed through authenticated Cloud Functions.
    match /customer_purchases/{customerId}/purchases/{purchaseId} {
      allow read, write: if false;
    }

    // The authenticated API reads consent and the current assignment before
    // accessing records. No app can write or bypass those checks directly.
    match /privacy_preferences/{clientId} {
      allow read, write: if false;
    }
    match /privacy_acceptances/{clientId} {
      allow read, write: if false;
    }
    match /client_assignments/{clientId} {
      allow read, write: if false;
    }
    // Assignment history is append-only backend data. Authorization always
    // uses client_assignments while this collection preserves every version.
    match /client_assignment_history/{historyId} {
      allow read, write: if false;
    }
    match /client_intakes/{document=**} {
      allow read, write: if false;
    }
    match /client_records/{record=**} {
      allow read, write: if false;
    }

    match /platform_sessions/{document=**} {
      allow read, write: if false;
    }
    match /platform_auth_contexts/{document=**} {
      allow read, write: if false;
    }
    match /platform_login_state/{document=**} {
      allow read, write: if false;
    }
    match /audit_events/{document=**} {
      allow read, write: if false;
    }
    match /workflow_outbox/{document=**} {
      allow read, write: if false;
    }
    match /outbox_deliveries/{document=**} {
      allow read, write: if false;
    }
    match /staff_account_history/{document=**} {
      allow read, write: if false;
    }
    match /staff_password_setup/{document=**} {
      allow read, write: if false;
    }
    match /google_password_setup/{document=**} {
      allow read, write: if false;
    }
    match /staff_account_locks/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
