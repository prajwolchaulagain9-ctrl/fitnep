rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sessions and immutable audit/event metadata are owned by the trusted API.
    match /platform_sessions/{id} {
      allow read, write: if false;
    }
    match /platform_auth_contexts/{id} {
      allow read, write: if false;
    }
    match /platform_login_state/{id} {
      allow read, write: if false;
    }
    match /audit_events/{id} {
      allow read, write: if false;
    }
    match /workflow_outbox/{id} {
      allow read, write: if false;
    }
    match /outbox_deliveries/{id} {
      allow read, write: if false;
    }
    // Package selection and verified activation use the revocation-aware API.
    match /package_catalog/{id} {
      allow read, write: if false;
    }
    match /package_memberships/{id} {
      allow read, write: if false;
    }
    match /package_membership_guards/{id} {
      allow read, write: if false;
    }
    // Notification data is accessed only through authenticated Cloud Functions.
    // The Admin SDK bypasses these rules after the HTTPS layer verifies identity.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Workflow records are backend-owned. Mobile clients use the application
    // APIs rather than writing workflow events directly.
    match /diet_plans/{document=**} {
      allow read, write: if false;
    }
    match /messages/{document=**} {
      allow read, write: if false;
    }
    match /tasks/{document=**} {
      allow read, write: if false;
    }
    match /payments/{document=**} {
      allow read, write: if false;
    }

    // Fitness packages are accessed through the authenticated API. The API
    // enforces admin-only creation and validates the persisted schema.
    match /packages/{packageId} {
      allow read, write: if false;
    }

    // Package change history is written atomically by the authenticated API.
    // Mobile clients cannot forge actors, timestamps, or before/after values.
    match /package_change_history/{historyId} {
      allow read, write: if false;
    }

    // Purchases contain immutable customer contract snapshots and are only
    // accessed through authenticated Cloud Functions.
    match /customer_purchases/{customerId}/purchases/{purchaseId} {
      allow read, write: if false;
    }

    // The authenticated API reads consent and the current assignment before
    // accessing records. No app can write or bypass those checks directly.
    match /privacy_preferences/{clientId} {
      function canManageSharing() {
        let acceptance = /databases/$(database)/documents/privacy_acceptances/$(clientId);
        return request.auth != null &&
          request.auth.uid == clientId &&
          request.auth.token.email_verified == true &&
          request.auth.token.get('mustChangePassword', false) == false &&
          request.auth.token.get('role', 'client') == 'client' &&
          exists(acceptance) &&
          get(acceptance).data.policy_version == '2' &&
          get(acceptance).data.accepted_at is timestamp;
      }

      function validSharingChoices() {
        let choices = request.resource.data;
        return choices.keys().hasOnly([
          'share_nutrition_records', 'share_meal_photos',
          'share_progress_photos', 'share_activity_data', 'updated_at'
        ]) &&
          choices.get('share_nutrition_records', false) is bool &&
          choices.get('share_meal_photos', false) is bool &&
          choices.get('share_progress_photos', false) is bool &&
          choices.get('share_activity_data', false) is bool &&
          choices.updated_at == request.time;
      }

      allow get: if canManageSharing();
      allow create, update: if canManageSharing() && validSharingChoices();
    }
    match /privacy_acceptances/{clientId} {
      function ownsAcceptance() {
        return request.auth != null &&
          request.auth.uid == clientId &&
          request.auth.token.get('mustChangePassword', false) == false &&
          request.auth.token.email_verified == true;
      }

      function validAcceptance() {
        let consent = request.resource.data;
        return consent.keys().hasOnly([
          'policy_version', 'accepted_at', 'age_at_acceptance',
          'guardian_consent_confirmed', 'guardian_consent_confirmed_at'
        ]) &&
          consent.policy_version == '2' &&
          consent.accepted_at == request.time &&
          consent.age_at_acceptance is int &&
          consent.age_at_acceptance >= 1 && consent.age_at_acceptance <= 120 &&
          ((consent.age_at_acceptance >= 18 &&
            consent.guardian_consent_confirmed == false &&
            !('guardian_consent_confirmed_at' in consent)) ||
           (consent.age_at_acceptance < 18 &&
            consent.guardian_consent_confirmed == true &&
            consent.guardian_consent_confirmed_at == request.time));
      }

      allow get: if ownsAcceptance();
      allow create: if ownsAcceptance() && validAcceptance();
      allow update: if ownsAcceptance() && validAcceptance() &&
        (resource.data.get('policy_version', '') != '2' ||
         !(resource.data.get('accepted_at', null) is timestamp));
    }
    match /client_assignments/{clientId} {
      allow read, write: if false;
    }
    match /client_records/{record=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
