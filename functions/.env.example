# Server configuration only. Copy to .env locally; never add secrets to Flutter.
SIGNUP_EMAIL_OTP_ENABLED=true
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=FitNEP
# BREVO_API_KEY and SIGNUP_OTP_HASH_SECRET use Firebase Secret Manager in hosting
# and functions/.secret.local in the local emulator. See docs/signup.md.
