# Server configuration only. Copy to .env locally; never add secrets to Flutter.
SIGNUP_EMAIL_OTP_ENABLED=true
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=FitNEP
# On the existing Render service, put BREVO_API_KEY and SIGNUP_OTP_HASH_SECRET
# (at least 32 random characters) in private environment variables. Firebase
# Functions uses Secret Manager; local emulators use functions/.secret.local.

# Standalone Node host (npm start after npm run build).
# Render supplies PORT and RENDER_GIT_COMMIT; use FITNEP_BUILD_SHA for another host.
FIREBASE_PROJECT_ID=your-owned-project-id
FITNEP_BUILD_SHA=replace-with-the-full-40-character-deployed-commit-sha
SESSION_IDLE_TIMEOUT_SECONDS=900
# Set this server-only Render variable to route new meal and progress photos to the authenticated fitnep folder.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# The project's public Firebase web API key for the hosted recovery adapter.
FIREBASE_WEB_API_KEY=your-firebase-project-web-api-key
# Set FIREBASE_SERVICE_ACCOUNT_JSON as a host secret, or GOOGLE_APPLICATION_CREDENTIALS
# to a private server-side service-account file. Never commit either credential.
